# --- Environment ---
# Ignore sensitive environment variables.
# Use a .env.example file to list needed variables for the project.
!.env.example


# --- Django ---
# Ignore the local SQLite database
*.sqlite3
db.sqlite3
db.sqlite3-journal

# Ignore user-uploaded files
/media/

# Ignore static files collected by collectstatic
/staticfiles/
/static_root/


# --- Node.js / Vite / React ---
# Ignore Node.js dependency folder
/node_modules/

# Ignore Vite cache and build output directory
.vite/
/dist/

# Ignore dependency-related logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*


# --- Python ---
# Ignore Python bytecode and cache
__pycache__/
*.py[cod]
*$py.class

# Ignore egg and distribution build artifacts
*.egg-info/
*.egg
/build/
/wheels/
*.tar.gz
*.whl


# --- IDE & Editor Configuration ---
# Visual Studio Code
.vscode/

# PyCharm
.idea/

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim
*.swp
*.swo


# --- Testing & Logs ---
# Ignore test coverage reports
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml

# Ignore log files
*.log


# --- OS Specific Files ---
# macOS
.DS_Store

# Windows
Thumbs.db
desktop.ini